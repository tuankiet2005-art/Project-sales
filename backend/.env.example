SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8003

# Neon / Render — jdbc:postgresql://... or postgresql://user:pass@host/db both work
DATABASE_URL=jdbc:postgresql://ep-xxxxxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=replace-me

APP_SEED_ENABLED=false
JPA_DDL_AUTO=none
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://your-app.vercel.app

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin!!@
ADMIN_TOKEN_SECRET=replace-with-a-long-random-string
